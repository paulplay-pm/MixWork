server {
    listen 443 ssl;
    server_name api.mixwork.example.com;

    ssl_certificate     /etc/ssl/certs/mixwork.crt;
    ssl_certificate_key /etc/ssl/private/mixwork.key;

    location / {
        proxy_pass http://127.0.0.1:8787;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;

        # --- WebSocket (ASR realtime relay) -------------------------------
        # The ASR relay upgrades /api/asr/realtime. Without these three
        # directives nginx answers the upgrade as an ordinary request and the
        # handshake dies in the proxy, not in the app — which looks like a
        # network bug and is not one.
        proxy_http_version 1.1;
        proxy_set_header Upgrade    $http_upgrade;
        proxy_set_header Connection "upgrade";

        # The relay's session can outlive the desktop's 60s recording window,
        # and the client waits up to 4s more for the final recognition.
        proxy_read_timeout 300s;
    }
}

# Plain HTTP variant for LAN/internal-only
server {
    listen 80;
    location / {
        proxy_pass http://127.0.0.1:8787;
        proxy_set_header Host              $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;

        proxy_http_version 1.1;
        proxy_set_header Upgrade    $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 300s;
    }
}
