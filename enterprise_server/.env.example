# MixCWork Enterprise Server — local dev environment
#
# Copy to `.env` (git-ignored) and fill in real values. `.env.example` is the
# committed template; `.env` is yours alone.
#
# Loading: `npm run dev` and `npm run reinit` already pass `--env-file=.env`
# to tsx → Node, so you do NOT need to `export` anything in your shell.
# Shell-level exports still take precedence and are how CI / production
# overrides these.

# --- Database ---------------------------------------------------------------
# Matches the Docker quickstart in README.md:
#   docker run -d --name mixcwork-pg \
#     -e POSTGRES_USER=mixcwork -e POSTGRES_PASSWORD=mixcwork \
#     -e POSTGRES_DB=mixcwork -p 5432:5432 postgres:16
#
# On macOS, Docker Desktop's backend binds 5432 on the host, so we map to
# host port 5432 to avoid the conflict.
DATABASE_URL=postgres://mixcwork:mixcwork@localhost:5432/mixcwork

# --- Secrets (REQUIRED — server will refuse to start without them) -----------
# JWT signing key (HS256). ≥32 chars.
# Generate with:  openssl rand -hex 32
JWT_SECRET=

# AES-256-GCM master key for the provider-key vault. Must decode to 32 bytes.
# Generate with:  openssl rand -base64 32
MIXCWORK_VAULT_MASTER_KEY=

# --- Optional ---------------------------------------------------------------
# HTTP listen port. Default: 8787
# Shell `PORT=9000 npm run dev` always wins over this file, so CI / ad-hoc
# overrides still work without editing `.env`.
PORT=8787

# Override path to the built SPA. Default: <cwd>/web-dist
# WEB_DIST_DIR=./web-dist

# --- Desktop SSO callback port ---------------------------------------------
# The desktop binds this loopback port and forwards
# http://localhost:<port>/callback as the OAuth `redirect_uri` to the
# IdP (Feishu, Okta, etc.). The IdP compares this string literally
# against the Authorized redirect URI list registered on the enterprise
# app, so this value MUST be the same one registered in the IdP's
# developer console.
#
# Example default URL: http://localhost:53231/callback
#
# The desktop fetches this value at login time (GET /auth/sso/redirect-port)
# so the server is the single source of truth — change here, restart the
# server, every desktop gets the new value next login. Default: 53231.
# A shell `SSO_DESKTOP_REDIRECT_PORT=... npm run dev` always wins over
# this file.
SSO_DESKTOP_REDIRECT_PORT=53231

# --- Enterprise web SSO callback URL --------------------------------------
# When a user signs in to the Enterprise web console (the SPA at
# /login), the IdP redirects to this URL on the Enterprise server
# itself, NOT to the desktop's loopback. The server's
# /auth/sso/callback handler consumes the `code`, exchanges it for a
# JWT, and renders a self-closing HTML page that stores the token in
# sessionStorage and jumps to "/".
#
# Example for a dev install: https://localhost:8787/auth/sso/callback
# Example for a production install: https://api.mixcwork.example/auth/sso/callback
#
# The IdP's Authorized redirect URI list must include this EXACT string
# (scheme + host + port-if-nonstandard + path), or the IdP will reject
# the authorize request with error 20029 ("重定向 URL 有误"). The port
# here is just the Enterprise server's listen port (PORT above) — no
# extra configuration is needed; this block is documentation so admins
# know what to paste into the IdP console.
#
# (If you ever proxy the Enterprise server behind a TLS terminator on
# 443, omit the explicit :8787 from the URL you register with the IdP.)

# --- Image & install paths (NEW) -----------------------------------------
# Where the CLI looks for compose.yml / Dockerfile before init. Defaults to
# the install path of the mixcwork-server binary.
# INSTALL_DIR=/opt/mixcwork

# Image tag for `docker compose pull`. Bump during upgrade.
IMAGE_TAG=latest
# Image repo, e.g. registry.example.com/mixcwork/enterprise-server
# IMAGE_REPO=enterprise-server

# Persistent data dir inside the container. Keep as /data.
DATA_DIR=/data

# --- One-time DB bootstrap (NEW, used by `mixcwork-server init` only) -----
# A superuser URL with CREATEDB / CREATEROLE privileges. The app container
# does NOT need this; it uses DATABASE_URL. After init, you can delete this
# line.
POSTGRES_SUPERUSER_URL=postgres://postgres:postgres@db-host:5432/postgres

# The public origin the desktop dials back on. The ASR relay hands the client a
# `wss://` URL built from this; behind a proxy it is derived from
# X-Forwarded-Proto, but a deployment that terminates TLS ITSELF (no proxy to
# set that header) must set this, or the client receives a `ws://` URL that a
# browser refuses to open from an https page.
# PUBLIC_BASE_URL=https://api.mixcwork.example.com
